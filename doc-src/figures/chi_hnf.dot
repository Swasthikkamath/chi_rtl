// Internal architecture of the coherent Home Node, chi_hnf_top.
// Rendered by the doc target; see Makefile.
//
// Laid out top to bottom so the figure fits a portrait page: a request is
// admitted or retried, serialized against the POS, driven by one globally
// serial FSM, and dispatched to whichever engine the opcode selects.
digraph chiHnf {
  rankdir=TB;
  splines=polyline;
  nodesep=0.28;
  ranksep=0.42;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  graph [fontname="Helvetica", fontsize=11, labeljust="l"];

  req [label="REQ in from NoC", shape=note, fillcolor="#ffffff"];

  subgraph cluster_admit {
    label="Admission and serialization";
    style="rounded"; color="#bba060"; fontcolor="#6b5520";
    retry  [label="chi_retry\nRetryAck, PCrdGrant,\nPCrdReturn\nretryRecords entries", fillcolor="#fdf0d5"];
    pos    [label="chi_pos\nposEntries entries\nline addresses", fillcolor="#fdf0d5"];
    hazard [label="chi_hazard\nsame-line and\nordering hazards", fillcolor="#fdf0d5"];
  }

  fsm [label="Home FSM   22 states, globally serial", fillcolor="#f7dce9", width=4.2];

  subgraph cluster_coh {
    label="Coherence";
    style="rounded"; color="#7799bb"; fontcolor="#224466";
    sf     [label="chi_snoop_filter\nsnpFilterEntries / snpFilterWays\nprecise sharer vector", fillcolor="#dce9f7"];
    snpgen [label="chi_snp_gen\nsequential unicast", fillcolor="#dce9f7"];
    dct    [label="chi_dct_ctrl\nforwarding snoops", fillcolor="#dce9f7"];
  }

  subgraph cluster_fwd {
    label="Forwarding and offload";
    style="rounded"; color="#77aa77"; fontcolor="#2f6b2f";
    dmt   [label="chi_dmt_ctrl\nReturnNID, ReturnTxnID", fillcolor="#e8f0e0"];
    dwt   [label="chi_dwt_ctrl\nDoDWT", fillcolor="#e8f0e0"];
    stash [label="chi_stash_ctrl\nstash snoop, Data Pull", fillcolor="#e8f0e0"];
  }

  subgraph cluster_ops {
    label="Operations";
    style="rounded"; color="#8888bb"; fontcolor="#333377";
    alu  [label="chi_atomic_alu\nStore, Load, Swap, Compare\n64-bit datapath", fillcolor="#e0e0f0"];
    cmo  [label="chi_cmo\ncache maintenance", fillcolor="#e0e0f0"];
    excl [label="chi_excl_mon\nexclMonitors entries", fillcolor="#e0e0f0"];
  }

  out [label="RSP / SNP / DAT out, and downstream REQ to SN-F",
    shape=note, fillcolor="#ffffff"];

  req -> pos   [label="  allocate"];
  req -> retry [label="  no resource"];
  pos -> hazard;
  hazard -> fsm [label="  stall or proceed"];

  fsm -> sf [label="  lookup"];
  sf -> snpgen [label="  sharer vector"];
  snpgen -> dct [label="  eligible peer"];

  fsm -> dmt; fsm -> dwt; fsm -> stash;
  fsm -> alu; fsm -> cmo; fsm -> excl;

  snpgen -> out [label="  SnpXX"];
  dct -> out; dmt -> out; dwt -> out; stash -> out;
  alu -> out; cmo -> out; excl -> out;
  fsm -> out [label="  Comp, CompData, DBIDResp"];
  retry -> out [label="  RetryAck, PCrdGrant"];
}
