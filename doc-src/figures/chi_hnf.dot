// Internal architecture of the coherent Home Node, chi_hnf_top.
// Rendered by the doc target; see Makefile.
//
// Laid out top to bottom so the figure fits a portrait page: a request is
// admitted or retried, allocated a POS entry and checked by the GPC, held by
// the hazard check until it is the oldest transaction for its location (and,
// when Endpoint-ordered, its ticket is served), started against the directory
// and SLC, and then runs its own obligations through the shared engines. The
// two notes on the right are top-level blocks the Home talks to.
digraph chiHnf {
  rankdir=TB;
  splines=polyline;
  nodesep=0.2;
  ranksep=0.42;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  graph [fontname="Helvetica", fontsize=11, labeljust="l"];

  req [label="REQ in from NoC", shape=note, fillcolor="#ffffff"];

  subgraph cluster_admit {
    label="Admission and ordering";
    style="rounded"; color="#bba060"; fontcolor="#6b5520";
    retry  [label="chi_retry\nRetryAck, PCrdGrant,\nPCrdReturn", fillcolor="#fdf0d5"];
    pos    [label="chi_pos\nposEntries entries, age matrix,\n{PAS, line} keys", fillcolor="#fdf0d5"];
    hazard [label="chi_hazard\nsame location, Endpoint Order,\nvictim lines", fillcolor="#fdf0d5"];
  }

  entries [label="Per-entry transactions   posEntries in parallel\nobligations: snoops, Requester data, memory ops,\nresponses, CompAck, directory update",
    fillcolor="#f7dce9", width=3.8];

  subgraph cluster_coh {
    label="Coherence";
    style="rounded"; color="#7799bb"; fontcolor="#224466";
    sf     [label="chi_snoop_filter\nlookup port, update port,\nlocked-way eviction,\ncoherency walk, SECDED", fillcolor="#dce9f7"];
    snpgen [label="chi_snp_gen\nsnoop issue, TxnID = owner\nSnp*Fwd for DCT", fillcolor="#dce9f7"];
    vb     [label="victim buffer\nSnpCleanInvalid + writeback", fillcolor="#dce9f7"];
  }

  subgraph cluster_mem {
    label="Memory side";
    style="rounded"; color="#77aa77"; fontcolor="#2f6b2f";
    slc     [label="chi_slc  (slcEn)\nSystem Level Cache, {PAS, line} keys\nlookup, read, update ports,\nmaintenance walk, SECDED", fillcolor="#e8f0e0"];
    tracker [label="chi_sn_tracker\nReadNoSnp(Sep), WriteNoSnp, CMO\nDMT and DWT without data\nRetry, PCrdReturn\none tracker reserved for GPT reads", fillcolor="#e8f0e0"];
    buf     [label="line buffers\nRequester, snoop, memory bytes", fillcolor="#e8f0e0"];
  }

  subgraph cluster_ops {
    label="Operations";
    style="rounded"; color="#8888bb"; fontcolor="#333377";
    alu   [label="chi_atomic_alu\n64-bit datapath", fillcolor="#e0e0f0"];
    excl  [label="chi_excl_mon", fillcolor="#e0e0f0"];
    stash [label="chi_stash_ctrl\nstash snoop, Data Pull", fillcolor="#e0e0f0"];
  }

  out [label="RSP / SNP / DAT / REQ out through chi_flit_fifo",
    shape=note, fillcolor="#ffffff"];

  // Top-level blocks the Home talks to.
  gpc [label="chi_gpc  (top level)\nGranule Protection Check:\nGPI table, or GPT cache and walker",
    shape=note, fillcolor="#ffffff"];
  eo  [label="chi_eo_order  (top level)\nEndpoint Order tickets\nper {Requester, SN-F}",
    shape=note, fillcolor="#ffffff"];

  req -> pos   [label="  allocate"];
  req -> retry [label="  no entry"];
  pos -> hazard;
  hazard -> entries [label="  oldest for its location,\n  ticket served"];
  pos -> gpc [label="  check", dir=both, style=dashed, constraint=false];
  eo -> hazard [label="  ticket", dir=both, style=dashed, constraint=false];

  entries -> sf [label="  start: lookup"];
  entries -> slc [label="  lookup, read, update"];
  slc -> vb [label="  dirty eviction", constraint=false];
  gpc -> tracker [label="  GPT reads\n  (through the SLC\n  with gpcSlcAlloc)", style=dashed, constraint=false];
  entries -> snpgen;
  sf -> vb [label="  eviction"];
  vb -> snpgen;
  entries -> tracker;
  vb -> tracker;
  tracker -> buf [dir=both];
  // Keep the page portrait: the memory side is one column, and the two
  // top-level notes sit beside the admission block.
  slc -> tracker [style=invis];
  req -> gpc [style=invis];
  gpc -> eo [style=invis];
  entries -> alu; alu -> excl [style=invis]; excl -> stash [style=invis];

  snpgen -> out;
  tracker -> out;
  entries -> out;
  retry -> out;
}
