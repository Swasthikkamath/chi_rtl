// One channel of one crosspoint, chi_router (Section 13.5.5).
// Rendered by the doc target; see Makefile.
//
// Every input computes its route; every output arbitrates the inputs routed
// to it (QoS, then age, then round-robin), eligible only when its FIFO has
// space, and ends in an OUT_DEPTH-entry FIFO. No input ready depends on an
// output ready.
digraph chiXpRouter {
  rankdir=LR;
  splines=polyline;
  nodesep=0.22;
  ranksep=0.5;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  graph [fontname="Helvetica", fontsize=11, labeljust="l"];

  subgraph cluster_in {
    label="Inputs";
    style="rounded"; color="#8899aa"; fontcolor="#334455";
    in_net [label="network inputs\nmesh N, S, E, W | ring CW, CCW |\ncrossbar one per peer", fillcolor="#dce9f7"];
    in_dev [label="device inputs\nnumDevPortsPerXp nodes", fillcolor="#dce9f7"];
  }

  rc [label="chi_route_compute per input\ntargetNodeId -> one-hot output\nno route: drop, routeError", fillcolor="#fdf0d5"];

  subgraph cluster_out {
    label="Per output";
    style="rounded"; color="#bb8899"; fontcolor="#77334f";
    elig [label="eligible?\nFIFO has 1 free entry\n(2 for a ring injection)", fillcolor="#f7dce9"];
    arb [label="chi_vc_arb\naged first, then highest QoS,\nthen round-robin", fillcolor="#f7dce9"];
    fifo [label="output FIFO\nOUT_DEPTH = 2\nhops + 1 on a network output", fillcolor="#f7dce9"];
  }

  out [label="outputs\nvalid = FIFO not empty\nflit = FIFO head", shape=note, fillcolor="#ffffff"];
  rdy [label="input ready =\ngranted, or dropped", shape=note, fillcolor="#ffffff"];

  in_net -> rc;
  in_dev -> rc;
  rc -> arb [label="  request"];
  elig -> arb [label="  eligible"];
  arb -> fifo [label="  push the\n  granted flit"];
  fifo -> out [label="  next cycle"];
  fifo -> elig [label="  occupancy", style=dashed, constraint=false];
  arb -> rdy [style=dashed];
}
