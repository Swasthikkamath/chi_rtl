// ReadShared that misses everywhere, through the RTL (Section 14.2).
// Rendered by the doc target; see Makefile. The numbers are the steps of
// Table 14.1: the request goes down the left column, the response comes
// back up the right one.
digraph chiFlowRead {
  rankdir=TB;
  splines=polyline;
  nodesep=0.9;
  ranksep=0.32;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10, margin="0.14,0.08", width=3.1];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  graph [fontname="Helvetica", fontsize=11, labeljust="l"];

  s1  [label="1  RN-F, chi_link_rx\nReadShared received and buffered", fillcolor="#e8f0e0"];
  s2  [label="2  chi_sam, chi_hn_hash, chi_qos_reg\nHN-F chosen, TgtID written, token taken", fillcolor="#fdf0d5"];
  s3  [label="3  fabric, REQ network\nh + 1 crosspoints", fillcolor="#e0e0f0"];
  s4  [label="4  HN-F admission\nchi_pos entry allocated, GPC checked", fillcolor="#f7dce9"];
  s5  [label="5  HN-F start\nsnoop filter miss, SLC miss: plan", fillcolor="#f7dce9"];
  s6  [label="6  chi_sn_tracker\nReadNoSnp to the SN-F", fillcolor="#f7dce9"];
  s7  [label="7  SN-F\nmemory read, CompData to the Home", fillcolor="#dce9f7"];
  s8  [label="8  HN-F line buffer\nmemory bytes written", fillcolor="#f7dce9"];
  s9  [label="9  HN-F DAT output\nCompData, one packet per cycle", fillcolor="#f7dce9"];
  s10 [label="10  fabric, DAT network\nh + 1 crosspoints, chi_link_tx", fillcolor="#e0e0f0"];
  s11 [label="11  RN-F\nCompData received, CompAck sent", fillcolor="#dce9f7"];
  s12 [label="12  HN-F retirement\ndirectory update, entry freed", fillcolor="#f7dce9"];

  s1 -> s2 -> s3 -> s4 -> s5 -> s6;
  s6 -> s7 [label="  REQ"];
  s7 -> s8 -> s9 -> s10 -> s11 -> s12;

  { rank=same; s1; s12; }
  { rank=same; s2; s11; }
  { rank=same; s3; s10; }
  { rank=same; s4; s9; }
  { rank=same; s5; s8; }
  { rank=same; s6; s7; }
}
