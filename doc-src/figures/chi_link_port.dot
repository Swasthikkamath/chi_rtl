// chi_link_port for a Requester port (Section 13.3).
// Rendered by the doc target; see Makefile.
//
// Left: the node's chi_if pins. Right: the fabric's valid/ready ports.
// Each received channel has a receive buffer that issues L-Credits; each
// transmitted channel spends a credit per flit and returns the rest with
// LCrdReturn when it deactivates.
digraph chiLinkPort {
  rankdir=LR;
  splines=polyline;
  nodesep=0.25;
  ranksep=0.55;
  bgcolor="white";
  node [shape=box, style="rounded,filled", fillcolor="#f5f5f5",
        fontname="Helvetica", fontsize=10, margin="0.14,0.08"];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];
  graph [fontname="Helvetica", fontsize=11, labeljust="l"];

  node_tx [label="RN pins (TX side)\nREQ, RSP, DAT FLITV / FLIT / FLITP\nLCRDV back to the node", shape=note, fillcolor="#ffffff"];
  node_rx [label="RN pins (RX side)\nRSP, SNP, DAT FLITV / FLIT / FLITP\nLCRDV from the node", shape=note, fillcolor="#ffffff"];

  subgraph cluster_rx {
    label="Receive: chi_link_rx per channel (REQ, RSP, DAT)";
    style="rounded"; color="#77aa77"; fontcolor="#2f6b2f";
    rxbuf [label="receive FIFO\nlcrdDepth entries", fillcolor="#e8f0e0"];
    rxcred [label="credit issue\nlcrdDepth at RUN entry,\n+1 per flit delivered", fillcolor="#e8f0e0"];
    rxchk [label="parity check\nLCrdReturn filter", fillcolor="#e8f0e0"];
    rxfsm [label="chi_link_fsm\n(receive side)", fillcolor="#e8f0e0"];
  }

  subgraph cluster_tx {
    label="Transmit: chi_link_tx per channel (RSP, SNP, DAT)";
    style="rounded"; color="#7799bb"; fontcolor="#224466";
    txcred [label="chi_lcrd_mgr\ncredits held", fillcolor="#dce9f7"];
    txgate [label="send while RUN\nand a credit is held;\nLCrdReturn in DEACTIVATE", fillcolor="#dce9f7"];
    txpar [label="parity generate", fillcolor="#dce9f7"];
    txfsm [label="chi_link_fsm\n(transmit side)", fillcolor="#dce9f7"];
  }

  act [label="activation per direction\nchannel outputs ORed onto\nLINKACTIVEREQ / LINKACTIVEACK", fillcolor="#fdf0d5"];

  fab_in [label="to the fabric\nREQ via SAM and QoS;\nRSP, DAT direct", shape=note, fillcolor="#ffffff"];
  fab_out [label="from the fabric\nRSP, SNP, DAT\n(crosspoint output FIFO)", shape=note, fillcolor="#ffffff"];

  node_tx -> rxchk [label="  flit"];
  rxchk -> rxbuf;
  rxbuf -> fab_in [label="  valid / ready"];
  rxcred -> node_tx [label="  LCRDV", style=dashed, constraint=false];
  rxbuf -> rxcred [style=dotted, arrowhead=none];
  rxfsm -> act [style=dotted, arrowhead=none];

  fab_out -> txgate [label="  valid / ready"];
  txgate -> txpar;
  txpar -> node_rx [label="  flit"];
  node_rx -> txcred [label="  LCRDV", style=dashed, constraint=false];
  txcred -> txgate [style=dotted, arrowhead=none];
  txfsm -> act [style=dotted, arrowhead=none];
}
